    "---\n",
    "## Task 5 — Evaluation (seqeval) <a id='6'></a>\n",
    "\n",
    "`seqeval` evaluates **complete span correctness** — a phrase is only counted as correct if ALL its tokens have the right label. This is stricter and more meaningful than token-level accuracy.\n",
    "\n",
    "**Metrics:**\n",
    "| Metric | Description |\n",
    "|---|---|\n",
    "| Precision | % of predicted spans that are correct |\n",
    "| Recall | % of true spans that were found |\n",
    "| F1 Score | Harmonic mean of Precision and Recall |\n",
    "| Accuracy | Token-level label match rate |"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────\n",
    "# TASK 5: EVALUATION ON HELD-OUT TEST SET\n",
    "# ─────────────────────────────────────────────────────────────\n",
    "\n",
    "def evaluate_on_test(trainer, tokenized_ds, id2label: dict, task_name: str):\n",
    "    \"\"\"\n",
    "    Evaluate a trained Trainer on the test split and print full seqeval report.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    trainer      : Trainer     – Trained HF Trainer.\n",
    "    tokenized_ds : DatasetDict – Tokenized dataset with 'test' split.\n",
    "    id2label     : dict        – ID → label string.\n",
    "    task_name    : str         – Display name.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    results      : dict   – Full seqeval results.\n",
    "    true_preds   : list   – Predicted label sequences (strings).\n",
    "    true_labels  : list   – Gold label sequences (strings).\n",
    "    \"\"\"\n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"  📊  {task_name} — Test Set Evaluation\")\n",
    "    print(f\"{'='*60}\")\n",
    "\n",
    "    # Trainer.predict() returns logits and labels for the full test set\n",
    "    preds_output = trainer.predict(tokenized_ds[\"test\"])\n",
    "    logits       = preds_output.predictions\n",
    "    labels       = preds_output.label_ids\n",
    "\n",
    "    predictions  = np.argmax(logits, axis=-1)\n",
    "\n",
    "    # Convert to string labels, skipping -100 positions\n",
    "    true_labels  = [\n",
    "        [id2label[l] for l in row if l != -100]\n",
    "        for row in labels\n",
    "    ]\n",
    "    true_preds   = [\n",
    "        [id2label[p] for p, l in zip(pred_row, label_row) if l != -100]\n",
    "        for pred_row, label_row in zip(predictions, labels)\n",
    "    ]\n",
    "\n",
    "    # Full seqeval computation\n",
    "    results = seqeval_metric.compute(\n",
    "        predictions = true_preds,\n",
    "        references  = true_labels\n",
    "    )\n",
    "\n",
    "    # ── Print overall metrics ─────────────────────────────────\n",
    "    print(f\"\\n  Overall Metrics (Test Set):\")\n",
    "    print(f\"    Precision : {results['overall_precision']:.4f}\")\n",
    "    print(f\"    Recall    : {results['overall_recall']:.4f}\")\n",
    "    print(f\"    F1 Score  : {results['overall_f1']:.4f}\")\n",
    "    print(f\"    Accuracy  : {results['overall_accuracy']:.4f}\")\n",
    "\n",
    "    # ── Print per-class breakdown ─────────────────────────────\n",
    "    per_class = {k: v for k, v in results.items() if not k.startswith(\"overall\")}\n",
    "    if per_class:\n",
    "        rows = []\n",
    "        for label, stats in per_class.items():\n",
    "            if isinstance(stats, dict):\n",
    "                rows.append({\n",
    "                    \"Label\"    : label,\n",
    "                    \"Precision\": round(stats.get(\"precision\", 0), 4),\n",
    "                    \"Recall\"   : round(stats.get(\"recall\",    0), 4),\n",
    "                    \"F1\"       : round(stats.get(\"f1\",        0), 4),\n",
    "                    \"Support\"  : stats.get(\"number\", 0)\n",
    "                })\n",
    "        if rows:\n",
    "            print(f\"\\n  Per-Class Breakdown:\")\n",
    "            display(\n",
    "                pd.DataFrame(rows)\n",
    "                  .set_index(\"Label\")\n",
    "                  .sort_values(\"F1\", ascending=False)\n",
    "            )\n",
    "\n",
    "    return results, true_preds, true_labels\n",
    "\n",
    "\n",
    "# ── Evaluate both models on held-out test set ─────────────────\n",
    "pos_results,   pos_preds,   pos_true   = evaluate_on_test(\n",
    "    pos_trainer,   pos_tokenized,   pos_id2label,   \"POS Tagging\"\n",
    ")\n",
    "chunk_results, chunk_preds, chunk_true = evaluate_on_test(\n",
    "    chunk_trainer, chunk_tokenized, chunk_id2label, \"Chunking\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
