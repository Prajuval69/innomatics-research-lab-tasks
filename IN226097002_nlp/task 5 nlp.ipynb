    "---\n",
    "## Task 3 — Model Setup <a id='4'></a>\n",
    "\n",
    "We use `AutoModelForTokenClassification` which extends DistilBERT with a linear classification head applied independently to **every** token's hidden state:\n",
    "\n",
    "```\n",
    "Input Tokens  [CLS] w1  w2  ... wN  [SEP]\n",
    "                │    │   │       │    │\n",
    "                ▼    ▼   ▼       ▼    ▼\n",
    "         DistilBERT Encoder (6 transformer layers, hidden=768)\n",
    "                │    │   │       │    │\n",
    "                ▼    ▼   ▼       ▼    ▼\n",
    "         Dropout(0.1) applied to every token representation\n",
    "                │    │   │       │    │\n",
    "                ▼    ▼   ▼       ▼    ▼\n",
    "         Linear(768 → num_labels)  ← applied per token\n",
    "                │    │   │       │    │\n",
    "                ▼    ▼   ▼       ▼    ▼\n",
    "         Logits → CrossEntropyLoss (ignores -100 positions)\n",
    "```"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────\n",
    "# TASK 3: MODEL SETUP\n",
    "# ─────────────────────────────────────────────────────────────\n",
    "\n",
    "def build_token_classifier(label_list: list,\n",
    "                            checkpoint: str = MODEL_CHECKPOINT):\n",
    "    \"\"\"\n",
    "    Build AutoModelForTokenClassification with correct label mappings.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    label_list : list of str – All unique label names.\n",
    "    checkpoint : str         – Hugging Face model identifier.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    model    : AutoModelForTokenClassification\n",
    "    id2label : dict – int → label string\n",
    "    label2id : dict – label string → int\n",
    "    \"\"\"\n",
    "    # Build bidirectional label mappings\n",
    "    id2label = {i: label for i, label in enumerate(label_list)}\n",
    "    label2id = {label: i for i, label in enumerate(label_list)}\n",
    "\n",
    "    # Load model with classification head sized to num_labels\n",
    "    model = AutoModelForTokenClassification.from_pretrained(\n",
    "        checkpoint,\n",
    "        num_labels = len(label_list),\n",
    "        id2label   = id2label,       # Stored in model config for inference\n",
    "        label2id   = label2id\n",
    "    )\n",
    "    return model, id2label, label2id\n",
    "\n",
    "\n",
    "# ── Build POS Tagging model ───────────────────────────────────\n",
    "print(\"⏳ Building POS Tagging model...\")\n",
    "pos_model, pos_id2label, pos_label2id = build_token_classifier(POS_LABELS)\n",
    "pos_params = sum(p.numel() for p in pos_model.parameters())\n",
    "print(f\"✅ POS Model   | num_labels: {len(POS_LABELS)} | Total params: {pos_params:,}\")\n",
    "\n",
    "# ── Build Chunking model ──────────────────────────────────────\n",
    "print(\"⏳ Building Chunking model...\")\n",
    "chunk_model, chunk_id2label, chunk_label2id = build_token_classifier(CHUNK_LABELS)\n",
    "chunk_params = sum(p.numel() for p in chunk_model.parameters())\n",
    "print(f\"✅ Chunk Model | num_labels: {len(CHUNK_LABELS)} | Total params: {chunk_params:,}\")\n",
    "\n",
    "print(\"\\n── id2label (POS, first 10) ──\")\n",
    "print(dict(list(pos_id2label.items())[:10]))\n",
    "\n",
    "print(\"\\n── id2label (Chunk, all) ──\")\n",
    "print(chunk_id2label)"
   ]
  },
