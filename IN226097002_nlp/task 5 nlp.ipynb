    "ax.text(-0.05, 0.95, \"Chunk:\", fontsize=7.5, ha=\"right\", color=\"#7f8c8d\")\n",
    "\n",
    "# Legend\n",
    "legend_handles = [\n",
    "    mpatches.Patch(facecolor=c, label=l, edgecolor=\"#2c3e50\")\n",
