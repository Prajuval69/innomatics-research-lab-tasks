    "]\n",
    "ax.legend(handles=legend_handles, loc=\"lower right\", ncol=4,\n",
    "          fontsize=8, title=\"Chunk Tags\", framealpha=0.9)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"inference_visualisation.png\", dpi=130, bbox_inches=\"tight\")\n",
    "plt.show()"
   ]
