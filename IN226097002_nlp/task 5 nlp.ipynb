    "---\n",
    "## Task 6 — Inference on Custom Sentences <a id='7'></a>\n",
    "\n",
    "The `predict_sentence()` function:\n",
    "1. Tokenizes the raw string (no pre-splitting required)\n",
    "2. Runs forward pass through the trained model\n",
    "3. Decodes logits → predicted label IDs\n",
    "4. Maps subword predictions **back** to original words (first-subword rule)\n",
    "5. Returns a clean `[(word, label)]` list"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────\n",
    "# TASK 6: INFERENCE ON CUSTOM SENTENCES\n",
    "# ─────────────────────────────────────────────────────────────\n",
    "\n",
    "def predict_sentence(sentence: str,\n",
    "                     model,\n",
    "                     tokenizer,\n",
    "                     id2label: dict) -> list:\n",
    "    \"\"\"\n",
    "    Predict token-level labels for a raw sentence.\n",
    "\n",
    "    Maps subword predictions back to original words by taking\n",
    "    the first subword's prediction for each word.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    sentence  : str  – Raw input text.\n",
    "    model     :      – Trained AutoModelForTokenClassification.\n",
    "    tokenizer :      – Matching tokenizer.\n",
    "    id2label  : dict – int → label string mapping.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    list of (word, label) tuples.\n",
    "    \"\"\"\n",
    "    model.eval()\n",
    "    model.to(DEVICE)\n",
    "\n",
    "    # Tokenize the raw sentence (not pre-split)\n",
    "    inputs = tokenizer(\n",
    "        sentence,\n",
    "        return_tensors = \"pt\",\n",
    "        truncation     = True,\n",
    "        max_length     = MAX_LEN\n",
    "    ).to(DEVICE)\n",
    "\n",
    "    with torch.no_grad():\n",
    "        outputs     = model(**inputs)\n",
    "        predictions = torch.argmax(outputs.logits, dim=-1)[0]   # (seq_len,)\n",
    "\n",
    "    # Get word_ids to map subwords → original words\n",
    "    word_ids = tokenizer(\n",
    "        sentence,\n",
    "        truncation = True,\n",
    "        max_length = MAX_LEN\n",
    "    ).word_ids()\n",
    "\n",
    "    words      = sentence.split()\n",
    "    word_preds = {}   # word_index → first-subword prediction\n",
    "\n",
    "    for tok_idx, word_id in enumerate(word_ids):\n",
    "        if word_id is None:\n",
    "            continue                   # Skip [CLS] / [SEP]\n",
    "        if word_id not in word_preds:  # Only first subword per word\n",
    "            word_preds[word_id] = id2label[predictions[tok_idx].item()]\n",
    "\n",
    "    return [(words[i], word_preds.get(i, \"O\")) for i in range(len(words))]\n",
    "\n",
    "\n",
    "def display_prediction_table(sentence: str,\n",
    "                              pos_pairs: list,\n",
    "                              chunk_pairs: list):\n",
    "    \"\"\"Display POS and Chunk predictions side-by-side.\"\"\"\n",
    "    df = pd.DataFrame({\n",
    "        \"Word\"      : [w for w, _ in pos_pairs],\n",
    "        \"POS Tag\"   : [l for _, l in pos_pairs],\n",
    "        \"Chunk Tag\" : [l for _, l in chunk_pairs]\n",
    "    })\n",
    "    print(f'\\nInput: \"{sentence}\"')\n",
    "    display(df)\n",
    "\n",
    "\n",
    "# ── Run inference on 4 custom sentences ──────────────────────\n",
    "test_sentences = [\n",
    "    \"John works at Google in California .\",\n",
    "    \"The quick brown fox jumps over the lazy dog .\",\n",
    "    \"Apple released a new iPhone model yesterday .\",\n",
    "    \"She was reading an interesting book in the library .\"\n",
    "]\n",
    "\n",
    "for sent in test_sentences:\n",
    "    pos_pairs   = predict_sentence(sent, pos_model,   tokenizer, pos_id2label)\n",
    "    chunk_pairs = predict_sentence(sent, chunk_model, tokenizer, chunk_id2label)\n",
    "    display_prediction_table(sent, pos_pairs, chunk_pairs)\n",
    "    print()"
   ]
  },
